PORT=3001
HOST=127.0.0.1
# Supabase > Connect > Session pooler (porta 5432, compatível com IPv4).
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@POOLER_HOST:5432/postgres
# Use o certificado CA do painel se a cadeia não for reconhecida pelo Node.
# Opcional: conexão administrativa exclusiva para db:migrate, quando DATABASE_URL usa moneyfinder_app.
DATABASE_ADMIN_URL=
DATABASE_CA_PATH=
DATABASE_SSL=true
JWT_SECRET=substitua-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1h
FRONTEND_ORIGIN=http://127.0.0.1:5173
